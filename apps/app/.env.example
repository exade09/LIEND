# LIEND App — copy to .env.local. Never commit real values.

# Required: LIEND API origin. Unset = App shows "API not configured".
NEXT_PUBLIC_API_URL=http://localhost:3002

# Required: own origin, for building absolute deep links.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: back-to-landing links.
# NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Extension distribution (mirrors the landing).
NEXT_PUBLIC_EXTENSION_MODE=download
# NEXT_PUBLIC_EXTENSION_URL=

# LIEND token — leave unset until launch.
# NEXT_PUBLIC_LIEND_TOKEN_MINT=
# NEXT_PUBLIC_LIEND_MIN_HOLDER_BALANCE=
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
