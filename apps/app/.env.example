# LONS App — copy to .env.local. Never commit real values.

# Required: LONS API origin. Unset = App shows "API not configured".
NEXT_PUBLIC_API_URL=http://localhost:3002

# Required: own origin, for building absolute deep links.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: back-to-landing links.
# NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# Extension distribution (mirrors the landing).
NEXT_PUBLIC_EXTENSION_MODE=download
# NEXT_PUBLIC_EXTENSION_URL=

# LONS token — leave unset until launch.
# NEXT_PUBLIC_LONS_TOKEN_CONTRACT=
# NEXT_PUBLIC_LONS_MIN_HOLDER_BALANCE=
