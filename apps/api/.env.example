# LIEND API — copy to .env.local and fill in. NEVER commit real values.

# --- Durable persistence (REQUIRED in production) ---------------------------
# Standard Postgres connection string. Neon is the initial host, but any
# Postgres works — nothing in the code depends on a provider-specific API.
# Use the provider's POOLED endpoint for serverless deployments.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Security (REQUIRED in production) --------------------------------------
# HMAC key for session cookies. Generate with: openssl rand -base64 32
# LIEND_SESSION_SECRET=

# Exact, comma-separated origins allowed to call this API with credentials.
# Deny-by-default: empty blocks all cross-origin browser access.
# A `.vercel.app` suffix is NEVER trusted implicitly — list each origin.
LIEND_ALLOWED_ORIGINS=http://localhost:3001

# --- Solana RPC (optional) -------------------------------------------------
# Used to read the connected wallet's SPL token accounts.
# If unset, the API falls back to public mainnet RPC endpoints.
# LIEND_SOLANA_RPC_URL=
# LIEND_TOKEN_MINT=
# LIEND_MIN_HOLDER_BALANCE=

# --- Optional ---------------------------------------------------------------
# LIEND_API_VERSION=0.1.0
