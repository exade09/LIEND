# LONS Extension build configuration.
#
# These are BUILD-TIME values injected by build.mjs. The extension does not
# read them at runtime, so changing an origin requires a rebuild and a new
# release — this is the extension half of the custom-domain migration.

LONS_APP_URL=http://localhost:3001
LONS_API_URL=http://localhost:3002

# Set to 1 for development diagnostics in the page console.
# Compiled out entirely when unset.
# LONS_DEBUG=1
