# LONS Landing — copy to .env.local. Never commit real values.
#
# Every destination is optional. An unset link is HIDDEN in the UI rather than
# falling back to a service root, so nothing ever points somewhere misleading.

# Own origin (metadata / OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LONS App — powers the "Launch App" CTA. Unset = CTA renders disabled.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# LONS API — used by the ACCESS GATE to resolve holder eligibility after launch.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Extension distribution.
#   webstore  -> "Add to Chrome" (production default)
#   download  -> "Download Extension" + manual install steps
NEXT_PUBLIC_EXTENSION_MODE=webstore
NEXT_PUBLIC_EXTENSION_URL=https://chromewebstore.google.com/detail/liend/gbpmekokakgbojjkmcgcippmlmpjakia?authuser=0&hl=en

# Community / docs
# pons defaults to its verified Robinhood Chain launchpad root.
# Docs default to /docs on this site. Set an absolute GitBook URL when you publish one.
# NEXT_PUBLIC_PONS_URL=https://www.ponsfamily.com
NEXT_PUBLIC_X_URL=https://x.com/lonsfamily
# NEXT_PUBLIC_DOCS_URL=

# LONS token — leave unset until launch.
# NEXT_PUBLIC_LONS_TOKEN_CONTRACT=
# NEXT_PUBLIC_LONS_MIN_HOLDER_BALANCE=

# Landing admin at /admin — required to publish the public CA plaques.
# LONS_ADMIN_PASSWORD=
# Optional separate HMAC key for the admin cookie. Defaults to the password.
# LONS_ADMIN_SECRET=

# Durable CA store for serverless. Without one of these, publish still works
# in a single Node process (local `next dev` / `next start`) via data/published-ca.json.
# DATABASE_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
