# LIEND Landing — copy to .env.local. Never commit real values.
#
# Every destination is optional. An unset link is HIDDEN in the UI rather than
# falling back to a service root, so nothing ever points somewhere misleading.

# Own origin (metadata / OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LIEND App — powers the "Launch App" CTA. Unset = CTA renders disabled.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Extension distribution.
#   download  -> "Download Extension" + install steps  (current: no Web Store listing)
#   webstore  -> "Add to Chrome"
NEXT_PUBLIC_EXTENSION_MODE=download
# NEXT_PUBLIC_EXTENSION_URL=https://<host>/liend-extension.zip

# Community / docs
# Pump.fun defaults to https://pump.fun until the token page exists.
# Docs default to /docs on this site. Set an absolute GitBook URL when you publish one.
# NEXT_PUBLIC_PUMPFUN_URL=https://pump.fun
# NEXT_PUBLIC_X_URL=
# NEXT_PUBLIC_DOCS_URL=

# LIEND token — leave unset until launch. Unset = "utility activates after launch".
# NEXT_PUBLIC_LIEND_TOKEN_MINT=
